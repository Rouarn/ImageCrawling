# ============================================================
# 图片抓取器 · 后端环境变量示例（packages/backend）
#
# 使用方式：复制本文件为 packages/backend/.env，按需取消注释并填写，然后重启后端。
#   cp packages/backend/.env.example packages/backend/.env
#
# 每条都标注了：用途 / 是否必填 / 默认值 / 格式示例 / 取值来源。
# 优先级：真实进程环境变量 > packages/backend/.env > 代码内默认值。
# 本文件所有键默认注释掉，可安全入库；禁止写入真实代理地址、Cookie 或密钥。
# ============================================================

# ---------- 一、服务基础 ----------

# PORT：HTTP 监听端口。【可选】默认 3000
# 示例：3000 | 5678
# 取值：自行指定 1-65535 的空闲端口；根目录 scripts/dev/start-dev.sh 会强制以 5678 启动后端，并让前端代理到该端口
# PORT=5678

# HOST：HTTP 监听地址。【可选】默认 127.0.0.1（只监听本机）
# 示例：127.0.0.1 | 0.0.0.0
# 取值：一般不需要改；填 0.0.0.0 会把服务暴露到局域网，请自行评估风险
# HOST=127.0.0.1

# NODE_ENV：运行模式。【可选】默认空（非 production）
# 示例：production | development
# 取值：部署时填 production；只有 production 会让 /media 静态资源带 7 天缓存，其它值（含留空）不缓存
# NODE_ENV=production

# STORAGE_DIR：图片存储根目录，必须是绝对路径。【可选】默认 <仓库根目录>/data/library
# 示例：/absolute/path/to/image-crawling/data/library
# 取值：自行指定；首次运行自动创建，备份只需备份该目录
# STORAGE_DIR=/absolute/path/to/image-crawling/data/library

# DATA_DIR：运行时数据目录（人工验证使用的独立 Chrome profile 等）。【可选】默认 <仓库根目录>/data/browser
# 示例：/absolute/path/to/image-crawling/data/browser
# 取值：一般留空；该目录已在 .gitignore 中，profile 删掉后重新验证即可重建
# DATA_DIR=/absolute/path/to/image-crawling/data/browser

# ---------- 二、浏览器扩展导入 ----------

# IMPORT_TOKEN：扩展导入接口的令牌，扩展设置页填写的值必须与此处一致。【按需必填】默认空（导入接口禁用）
# 示例：执行 openssl rand -hex 24 生成的 48 位十六进制串；此处不要填真实令牌
# 取值：自行生成；留空后果：POST /api/import/image 与 GET /api/import/status 返回 503
# IMPORT_TOKEN=replace-with-a-random-token

# ---------- 三、运行调优 ----------

# CHROME_PATH：自定义 Chrome 可执行文件路径。【可选】默认空（自动探测系统 Chrome/Chromium，再回退 Puppeteer 自带版本）
# 示例：/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# 取值：用 `which google-chrome` 或应用安装位置；探测不到时无头抓取与人工验证窗口不可用
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# VERIFICATION_TIMEOUT_MS：等待人工完成人机校验的超时时间，单位毫秒。【可选】默认 300000（5 分钟）
# 示例：300000 | 600000
# 取值：正整数；超时后任务以 CHALLENGE_TIMEOUT 结束，网络较慢时可调大
# VERIFICATION_TIMEOUT_MS=300000

# VERIFICATION_PROFILE_TTL_MS：人工验证 profile 的保留时长，单位毫秒。【可选】默认 604800000（7 天）
# 示例：604800000
# 取值：正整数；超过该时长未使用的 profile 会在启动时清理，清除后需要重新完成一次校验
# VERIFICATION_PROFILE_TTL_MS=604800000

# ---------- 四、网络代理 ----------
#
# 适配器与静态请求使用代理的优先级：
#   1. GIRL_ATLAS_PROXY（仅 girl-atlas 适配器）
#   2. CRAWL_PROXY_URL
#   3. HTTPS_PROXY / HTTP_PROXY
#   4. macOS 系统代理（scutil --proxy 自动检测，无需配置）
#
# 格式统一为 http://主机:端口，需要认证时写 http://用户名:密码@主机:端口。
# 都不配置且系统也没有代理时，访问需要代理的站点会失败。

# CRAWL_PROXY_URL：通用出站代理，所有用到代理的适配器共用。【可选】默认空
# 示例：http://127.0.0.1:7897
# 取值：本机代理软件/VPN 提供的 HTTP 端口，写进 .env 即可，无需改系统设置
# CRAWL_PROXY_URL=http://127.0.0.1:7897

# HTTPS_PROXY：进程级 HTTPS 代理回退。【可选】默认空；优先级低于 CRAWL_PROXY_URL
# 示例：http://127.0.0.1:7897
# 取值：一般由 shell 或系统代理软件设置，不建议写进 .env
# HTTPS_PROXY=http://127.0.0.1:7897

# HTTP_PROXY：进程级 HTTP 代理回退。【可选】默认空；优先级低于 CRAWL_PROXY_URL
# 示例：http://127.0.0.1:7897
# 取值：一般由 shell 或系统代理软件设置，不建议写进 .env
# HTTP_PROXY=http://127.0.0.1:7897

# GIRL_ATLAS_PROXY：Girl Atlas 专用代理，优先级高于 CRAWL_PROXY_URL。【可选】默认空（回退出站代理/系统代理）
# 示例：http://127.0.0.1:7897
# 取值：使用 girl-atlas 站点时，本项或上面任一项至少设置一个；该站点本机 DNS 被污染，全部为空时无法访问
# GIRL_ATLAS_PROXY=http://127.0.0.1:7897

# ---------- 五、站点凭据 ----------

# GIRL_ATLAS_COOKIE：Girl Atlas 登录态 / 年龄门 Cookie（整条 Cookie 请求头）。【可选】默认空（以访客身份访问）
# 示例：session=example-value; cf_clearance=example-value
# 取值：浏览器开发者工具 → Network → 任一请求的 Cookie 请求头整条复制；该值只在内存中使用，不会写日志
# GIRL_ATLAS_COOKIE=session=example-value
