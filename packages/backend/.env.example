# =============================================================================
# 后端环境变量模板
#
# 使用方式：复制本文件为 packages/backend/.env，按需取消注释并填写，然后重启后端。
#   cp packages/backend/.env.example packages/backend/.env
#
# 优先级：真实进程环境变量 > packages/backend/.env > 代码内默认值。
# 本文件只用于文档与占位示例，禁止写入真实代理地址、Cookie 或密钥。
# =============================================================================

# -----------------------------------------------------------------------------
# 一、服务基础配置（一般不需要改）
# -----------------------------------------------------------------------------

# HTTP 监听端口。整数，1-65535；留空或非法值回落到 3000。
# 注意：根目录 scripts/dev/start-dev.sh 会强制以 5678 启动后端，并让前端代理到该端口。
# PORT=5678

# 图片存储根目录，必须是绝对路径；留空默认为仓库根目录下的 data/library/。
# STORAGE_DIR=/absolute/path/to/image-crawling/data/library

# 运行时数据目录（人工验证使用的独立 Chrome profile 等）；留空默认为仓库根目录下的 data/browser/。
# 该目录已在 .gitignore 中，不会进入仓库。
# DATA_DIR=/absolute/path/to/image-crawling/data/browser

# 运行模式。填 production 时 /media 静态资源带 7 天缓存，其它值（含留空）不缓存。
# NODE_ENV=production

# -----------------------------------------------------------------------------
# 二、运行调优项（可选，留空即使用默认值）
# -----------------------------------------------------------------------------

# 自定义 Chrome 可执行文件路径；留空时自动探测系统 Chrome / Chromium。
# 格式：可执行文件绝对路径。留空后果：自动探测；探测不到时无头抓取与人工验证窗口不可用。
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# 等待人工完成人机校验的超时时间，单位毫秒，正整数；留空默认为 300000（5 分钟）。
# 超时后任务以 CHALLENGE_TIMEOUT 结束。
# VERIFICATION_TIMEOUT_MS=300000

# 人工验证 profile 的保留时长，单位毫秒，正整数；留空默认为 604800000（7 天）。
# 超过该时长未使用的 profile 会在启动时清理，清除后需要重新完成一次校验。
# VERIFICATION_PROFILE_TTL_MS=604800000

# -----------------------------------------------------------------------------
# 三、网络代理（可选；未配置时自动检测 macOS 系统代理）
# -----------------------------------------------------------------------------
#
# 适配器与静态请求使用代理的优先级：
#   1. GIRL_ATLAS_PROXY（仅 girl-atlas 适配器）
#   2. CRAWL_PROXY_URL
#   3. HTTPS_PROXY / HTTP_PROXY（进程环境变量）
#   4. macOS 系统代理（scutil --proxy），无需配置
#
# 格式：http://主机:端口 ，如需认证可写 http://用户名:密码@主机:端口。
# 留空后果：使用系统代理；系统也没有代理时不走代理，访问需要代理的站点会失败。

# 通用出站代理（所有用到代理的适配器）。
# CRAWL_PROXY_URL=http://127.0.0.1:7897

# 系统级代理回退，一般由 shell 或系统代理软件设置，不建议写进 .env。
# HTTPS_PROXY=http://127.0.0.1:7897
# HTTP_PROXY=http://127.0.0.1:7897

# Girl Atlas 专用代理，优先级高于 CRAWL_PROXY_URL。
# 使用 girl-atlas 站点时：本项或上面任一项至少设置一个；都不设置时回退到 macOS 系统代理。
# GIRL_ATLAS_PROXY=http://127.0.0.1:7897

# -----------------------------------------------------------------------------
# 四、站点凭据（可选；留空即不启用）
# -----------------------------------------------------------------------------

# Girl Atlas 登录态 / 年龄门 Cookie（整条 Cookie 请求头）。
# 格式：name=value; name2=value2。留空后果：以访客身份访问，遇到 18+ 年龄门时依赖页面自动点击。
# 该值只在内存中使用，不会写日志。
# GIRL_ATLAS_COOKIE=session=example-value
